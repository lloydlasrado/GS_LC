// valid palin
public boolean isPalindrome(String s) {
        //base
        if(s == null || s.isEmpty()) return false;

        //declare
        int len = s.length(), left = 0, right = len - 1;
        s = s.trim().toLowerCase();
        
        //2 pointer
        while(left < right) {
            while(left < right && !Character.isLetterOrDigit(s.charAt(left))) left++;
            while(left < right && !Character.isLetterOrDigit(s.charAt(right))) right--;

            if(left < right && s.charAt(left) != s.charAt(right)) return false;
            left++; 
            right--;
        }
        return true;
    }
    //TC : O(n)

// Given a string s, return true if the s can be palindrome after deleting at most one character from it.
public boolean validPalindrome(String s) {
        if(s == null || s.isEmpty()) return false;

        //declare
        int len = s.length(), left = 0, right = len - 1;
        while(left < right) {
            if(s.charAt(left) != s.charAt(right)) {
                return checkPalin(s, left, right - 1) || checkPalin(s,left + 1, right);
            }
            left++;
            right--;
        }
        return true;
    }

    private boolean checkPalin(String s, int left, int right) {
        while(left < right) {
            if(s.charAt(left) != s.charAt(right)) return false;
            left++;
            right--;
        }
        return true;
    }
    // TC : O(n)
